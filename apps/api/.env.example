# SmartProcure-Pay API Environment Variables
PORT=4000
NODE_ENV=development
CORS_ORIGIN=http://localhost:3000
KEYCLOAK_ISSUER=http://localhost:8080/realms/smartprocure
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/smartprocure/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=smartprocure-api

# Gemini extraction adapter (#38): never use VITE_ prefixed secrets.
AI_PROVIDER=disabled
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
AI_DOCUMENT_POLICY=synthetic-only
AI_TIMEOUT_MS=30000
AI_REQUESTS_PER_MINUTE=20
AI_REQUESTS_PER_DAY=100
AI_TOKENS_PER_DAY=100000
AI_MAX_INPUT_TOKENS=8192
AI_MAX_OUTPUT_TOKENS=4096
