{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.opendx.invalid/proposed/issue25-mapping.schema.json",
  "title": "Issue 25 reviewed item mapping candidate — requires A/C review",
  "definitions": {
    "Request": {
      "type": "object", "additionalProperties": false,
      "properties": { "line_path": { "type": "string", "pattern": "^/lines/(0|[1-9][0-9]?)$" } }, "required": ["line_path"]
    },
    "ConfirmationRequest": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "expected_revision": { "type": "integer", "minimum": 1 },
        "selected_po_item_id": { "type": ["string", "null"], "format": "uuid" },
        "reason": { "type": "string", "minLength": 1, "maxLength": 500 }
      }, "required": ["expected_revision", "selected_po_item_id", "reason"]
    },
    "Suggestion": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "state": { "const": "REVIEW_REQUIRED" },
        "resolution": { "enum": ["MATCH", "AMBIGUOUS", "UNKNOWN"] },
        "method": { "enum": ["DETERMINISTIC", "GEMINI", "DETERMINISTIC_FALLBACK"] },
        "profile_version": { "const": "reviewed-item-mapping-v1" },
        "candidates": { "type": "array", "maxItems": 40, "items": {
          "type": "object", "additionalProperties": false,
          "properties": { "po_item_id": { "type": "string", "format": "uuid" }, "confidence": { "type": "number", "minimum": 0, "maximum": 1 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 } },
          "required": ["po_item_id", "reason"]
        } },
        "provenance": {
          "type": "object", "additionalProperties": false,
          "properties": { "provider": { "const": "gemini" }, "model_version": { "type": "string", "pattern": "^gemini-[a-z0-9.-]{1,100}$" }, "prompt_version": { "type": "string", "minLength": 1, "maxLength": 100 }, "run_id": { "type": "string", "format": "uuid" } },
          "required": ["provider", "model_version", "prompt_version", "run_id"]
        },
        "usage": { "type": "object", "additionalProperties": false,
          "properties": { "input_tokens": { "type": "integer", "minimum": 1 }, "reserved_tokens": { "type": "integer", "minimum": 1 }, "reported_total_tokens": { "type": "integer", "minimum": 0 } }, "required": ["input_tokens", "reserved_tokens"] },
        "provider_failure": { "type": "object", "additionalProperties": false,
          "properties": { "code": { "enum": ["NOT_CONFIGURED", "INVALID_INPUT", "DISCLOSURE_DENIED", "TIMEOUT", "RATE_LIMITED", "BUDGET_EXCEEDED", "INVALID_OUTPUT", "UNAVAILABLE", "REJECTED"] }, "retryable": { "type": "boolean" }, "run_id": { "type": "string", "format": "uuid" } }, "required": ["code", "retryable"] }
      },
      "required": ["state", "resolution", "method", "profile_version", "candidates"],
      "allOf": [
        { "if": { "properties": { "resolution": { "const": "MATCH" } } }, "then": { "properties": { "candidates": { "minItems": 1, "maxItems": 1 } } } },
        { "if": { "properties": { "resolution": { "const": "UNKNOWN" } } }, "then": { "properties": { "candidates": { "maxItems": 0 } } } },
        { "if": { "properties": { "resolution": { "const": "AMBIGUOUS" } } }, "then": { "properties": { "candidates": { "minItems": 2 } } } },
        { "if": { "properties": { "method": { "const": "GEMINI" } } }, "then": { "required": ["provenance"] } },
        { "if": { "properties": { "method": { "const": "DETERMINISTIC_FALLBACK" } } }, "then": { "required": ["provider_failure"] } }
      ]
    },
    "Decision": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" }, "mapping_id": { "type": "string", "format": "uuid" },
        "confirmation_id": { "type": "string", "format": "uuid" }, "purchase_order_id": { "type": "string", "format": "uuid" },
        "line_path": { "type": "string", "pattern": "^/lines/(0|[1-9][0-9]?)$" }, "selected_po_item_id": { "type": ["string", "null"], "format": "uuid" },
        "actor_subject": { "type": "string", "minLength": 1, "maxLength": 200 }, "reason": { "type": "string", "minLength": 1, "maxLength": 500 },
        "decided_at": { "type": "string", "format": "date-time", "pattern": "Z$" }, "origin": { "enum": ["SUGGESTION", "MANUAL", "REJECTED"] },
        "source_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "facts_sha256": { "type": "string", "pattern": "^[a-f0-9]{64}$" }, "catalog_revision": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
        "dispatch_state": { "enum": ["PENDING", "NONE"] }
      },
      "required": ["id", "mapping_id", "confirmation_id", "purchase_order_id", "line_path", "selected_po_item_id", "actor_subject", "reason", "decided_at", "origin", "source_sha256", "facts_sha256", "catalog_revision", "dispatch_state"],
      "allOf": [{ "if": { "properties": { "selected_po_item_id": { "type": "null" } } }, "then": { "properties": { "origin": { "const": "REJECTED" }, "dispatch_state": { "const": "NONE" } } },
        "else": { "properties": { "origin": { "enum": ["SUGGESTION", "MANUAL"] }, "dispatch_state": { "const": "PENDING" } } } }]
    },
    "View": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "format": "uuid" }, "tenant_id": { "type": "string", "format": "uuid" }, "confirmation_id": { "type": "string", "format": "uuid" },
        "line_path": { "type": "string", "pattern": "^/lines/(0|[1-9][0-9]?)$" }, "revision": { "type": "integer", "minimum": 1 },
        "operation": { "$ref": "https://contracts.opendx.invalid/v1/platform.schema.json#/definitions/Operation" },
        "suggestion": { "$ref": "#/definitions/Suggestion" }, "decision": { "$ref": "#/definitions/Decision" }
      }, "required": ["id", "tenant_id", "confirmation_id", "line_path", "revision", "operation"]
    }
  }
}
