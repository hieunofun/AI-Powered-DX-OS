{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.opendx.invalid/proposed/issue54-mediation.schema.json",
  "description": "Proposed opt-in AI mediation DTOs. Owning policy/decision/Case integration and A/C contract review remain gates.",
  "definitions": {
    "Uuid": { "type": "string", "format": "uuid" },
    "Hash": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "Ref": { "$ref": "https://contracts.opendx.invalid/v1/platform.schema.json#/definitions/ResourceRef" },
    "Provenance": {
      "type": "object", "additionalProperties": false,
      "properties": { "provider": { "const": "gemini" }, "model_version": { "type": "string", "pattern": "^gemini-[a-z0-9.-]{1,100}$" }, "prompt_version": { "type": "string", "minLength": 1, "maxLength": 120 }, "run_id": { "$ref": "#/definitions/Uuid" } },
      "required": ["provider", "model_version", "prompt_version", "run_id"]
    },
    "Usage": {
      "type": "object", "additionalProperties": false,
      "properties": { "input_tokens": { "type": "integer", "minimum": 1 }, "reserved_tokens": { "type": "integer", "minimum": 1 }, "reported_total_tokens": { "type": "integer", "minimum": 0 } },
      "required": ["input_tokens", "reserved_tokens"]
    },
    "Result": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "status": { "enum": ["GROUNDED", "MISSING_EVIDENCE", "NO_SUPPORTED_ANSWER"] },
        "statements": { "type": "array", "maxItems": 32, "items": {
          "type": "object", "additionalProperties": false,
          "properties": { "fact_id": { "$ref": "#/definitions/Uuid" }, "code": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" }, "label": { "type": "string", "minLength": 1, "maxLength": 160 }, "value": { "type": "string", "minLength": 1, "maxLength": 1200 },
            "citation": { "type": "object", "additionalProperties": false, "properties": { "evidence_id": { "$ref": "#/definitions/Uuid" }, "sha256": { "$ref": "#/definitions/Hash" }, "facts_version": { "type": "string", "minLength": 1, "maxLength": 120 } }, "required": ["evidence_id", "sha256", "facts_version"] } },
          "required": ["fact_id", "code", "label", "value", "citation"]
        } },
        "missing_evidence": { "type": "array", "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } },
        "suggested_tool": { "enum": ["NONE", "case.read_summary", "case.request_evidence", "case.add_note"] },
        "provenance": { "$ref": "#/definitions/Provenance" }, "usage": { "$ref": "#/definitions/Usage" }
      }, "required": ["status", "statements", "missing_evidence", "suggested_tool"]
    },
    "Explanation": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/definitions/Uuid" }, "tenant_id": { "$ref": "#/definitions/Uuid" }, "case_id": { "$ref": "#/definitions/Uuid" }, "created_at": { "type": "string", "format": "date-time" }, "snapshot_sha256": { "$ref": "#/definitions/Hash" },
        "operation": { "$ref": "https://contracts.opendx.invalid/v1/platform.schema.json#/definitions/Operation" }, "result": { "$ref": "#/definitions/Result" } },
      "required": ["id", "tenant_id", "case_id", "created_at", "snapshot_sha256", "operation"]
    },
    "Action": {
      "oneOf": [
        { "type": "object", "additionalProperties": false, "properties": { "tool": { "enum": ["case.read_summary", "case.add_note"] }, "fact_ids": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "$ref": "#/definitions/Uuid" } } }, "required": ["tool", "fact_ids"] },
        { "type": "object", "additionalProperties": false, "properties": { "tool": { "const": "case.request_evidence" }, "missing_evidence_codes": { "type": "array", "minItems": 1, "maxItems": 32, "uniqueItems": true, "items": { "type": "string", "pattern": "^[A-Z][A-Z0-9_]{0,63}$" } } }, "required": ["tool", "missing_evidence_codes"] }
      ]
    },
    "Receipt": {
      "type": "object", "additionalProperties": false,
      "properties": { "action_id": { "$ref": "#/definitions/Uuid" }, "resource_ref": { "$ref": "#/definitions/Ref" }, "sha256": { "$ref": "#/definitions/Hash" }, "executed_at": { "type": "string", "format": "date-time" } },
      "required": ["action_id", "resource_ref", "sha256", "executed_at"]
    },
    "Proposal": {
      "type": "object", "additionalProperties": false,
      "properties": { "id": { "$ref": "#/definitions/Uuid" }, "tenant_id": { "$ref": "#/definitions/Uuid" }, "case_id": { "$ref": "#/definitions/Uuid" }, "explanation_id": { "$ref": "#/definitions/Uuid" }, "snapshot_sha256": { "$ref": "#/definitions/Hash" }, "policy_sha256": { "$ref": "#/definitions/Hash" }, "proposal_sha256": { "$ref": "#/definitions/Hash" }, "input": { "$ref": "#/definitions/Action" }, "risk": { "enum": ["R0", "R1", "R2"] }, "requires_approval": { "type": "boolean" }, "state": { "enum": ["AWAITING_APPROVAL", "READY", "APPROVED", "EXECUTED"] }, "created_at": { "type": "string", "format": "date-time" }, "decision_ref": { "$ref": "#/definitions/Ref" }, "receipt": { "$ref": "#/definitions/Receipt" } },
      "required": ["id", "tenant_id", "case_id", "explanation_id", "snapshot_sha256", "policy_sha256", "proposal_sha256", "input", "risk", "requires_approval", "state", "created_at"],
      "allOf": [
        { "if": { "properties": { "risk": { "enum": ["R1", "R2"] } } }, "then": { "properties": { "requires_approval": { "const": true } } } },
        { "if": { "properties": { "state": { "const": "EXECUTED" } } }, "then": { "required": ["receipt"] } },
        { "if": { "properties": { "state": { "const": "APPROVED" } } }, "then": { "required": ["decision_ref"] } }
      ]
    }
  }
}
