{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://contracts.opendx.invalid/v1/openresolve.schema.json",
  "title": "openresolve v1 proposed contracts",
  "definitions": {
    "Amount": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,15})(\\.[0-9]{1,2})?$"
    },
    "Quantity": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,4})?$"
    },
    "UnitPrice": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,13})(\\.[0-9]{1,4})?$"
    },
    "TaxFraction": {
      "type": "string",
      "pattern": "^(0(\\.[0-9]{1,4})?|1(\\.0{1,4})?)$"
    },
    "InvoiceLineDraft": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 500
        },
        "sku": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "quantity": {
          "allOf": [
            {
              "$ref": "#/definitions/Quantity"
            },
            {
              "not": {
                "pattern": "^0(?:\\.0+)?$"
              }
            }
          ]
        },
        "unit_price": {
          "$ref": "#/definitions/UnitPrice"
        },
        "tax_rate": {
          "$ref": "#/definitions/TaxFraction"
        },
        "line_subtotal": {
          "$ref": "#/definitions/Amount"
        },
        "tax_amount": {
          "$ref": "#/definitions/Amount"
        },
        "line_total": {
          "$ref": "#/definitions/Amount"
        }
      },
      "required": [
        "description",
        "quantity",
        "unit_price",
        "tax_rate",
        "line_subtotal",
        "tax_amount",
        "line_total"
      ]
    },
    "InvoiceDraftPayload": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "purchase_order_id": {
          "type": "string",
          "format": "uuid"
        },
        "seller_tax_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "buyer_tax_code": {
          "type": "string",
          "minLength": 1,
          "maxLength": 30
        },
        "invoice_number": {
          "type": "string",
          "minLength": 1,
          "maxLength": 100
        },
        "invoice_date": {
          "type": "string",
          "format": "date"
        },
        "currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "lines": {
          "type": "array",
          "items": {
            "$ref": "#/definitions/InvoiceLineDraft"
          },
          "minItems": 1,
          "maxItems": 1000
        },
        "subtotal": {
          "$ref": "#/definitions/Amount"
        },
        "tax_amount": {
          "$ref": "#/definitions/Amount"
        },
        "total_amount": {
          "$ref": "#/definitions/Amount"
        }
      },
      "required": [
        "purchase_order_id",
        "seller_tax_code",
        "buyer_tax_code",
        "invoice_number",
        "invoice_date",
        "currency",
        "lines",
        "subtotal",
        "tax_amount",
        "total_amount"
      ]
    },
    "ReceiptQuantities": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "expected": {
          "$ref": "#/definitions/Quantity"
        },
        "shipped": {
          "$ref": "#/definitions/Quantity"
        },
        "physically_counted": {
          "$ref": "#/definitions/Quantity"
        },
        "inspected": {
          "$ref": "#/definitions/Quantity"
        },
        "accepted": {
          "$ref": "#/definitions/Quantity"
        },
        "rejected": {
          "$ref": "#/definitions/Quantity"
        },
        "held": {
          "$ref": "#/definitions/Quantity"
        },
        "pending_inspection": {
          "$ref": "#/definitions/Quantity"
        },
        "missing": {
          "$ref": "#/definitions/Quantity"
        },
        "billable": {
          "$ref": "#/definitions/Quantity"
        },
        "package_count": {
          "type": "integer",
          "minimum": 0
        },
        "billable_policy_ref": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "expected",
        "shipped",
        "physically_counted",
        "inspected",
        "accepted",
        "rejected",
        "held",
        "pending_inspection",
        "missing",
        "billable",
        "package_count",
        "billable_policy_ref"
      ]
    },
    "CaseRequest": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "reason": {
          "type": "string",
          "enum": [
            "SHORT_DELIVERY",
            "QUALITY",
            "PRICE",
            "INVOICE_BEFORE_RECEIPT",
            "SOURCE_CONFLICT",
            "POST_HANDOVER_INCIDENT"
          ]
        },
        "subject_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pack_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "pack_id",
            "type",
            "id"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        }
      },
      "required": [
        "reason",
        "subject_ref",
        "evidence_ids",
        "severity"
      ]
    },
    "Case": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "format": "uuid"
        },
        "tenant_id": {
          "type": "string",
          "format": "uuid"
        },
        "reason": {
          "type": "string",
          "enum": [
            "SHORT_DELIVERY",
            "QUALITY",
            "PRICE",
            "INVOICE_BEFORE_RECEIPT",
            "SOURCE_CONFLICT",
            "POST_HANDOVER_INCIDENT"
          ]
        },
        "subject_ref": {
          "type": "object",
          "additionalProperties": false,
          "properties": {
            "pack_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "type": {
              "type": "string",
              "minLength": 1,
              "maxLength": 80
            },
            "id": {
              "type": "string",
              "format": "uuid"
            }
          },
          "required": [
            "pack_id",
            "type",
            "id"
          ]
        },
        "evidence_ids": {
          "type": "array",
          "items": {
            "type": "string",
            "format": "uuid"
          },
          "minItems": 1
        },
        "severity": {
          "type": "string",
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH"
          ]
        },
        "state": {
          "type": "string",
          "enum": [
            "OPEN",
            "TRIAGED",
            "INVESTIGATING",
            "PENDING_APPROVAL",
            "RESOLVING",
            "CLOSED"
          ]
        },
        "revision": {
          "type": "integer",
          "minimum": 1
        },
        "created_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        },
        "owner_subject": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200
        },
        "due_at": {
          "type": "string",
          "format": "date-time",
          "pattern": "Z$"
        }
      },
      "required": [
        "id",
        "tenant_id",
        "reason",
        "subject_ref",
        "evidence_ids",
        "severity",
        "state",
        "revision",
        "created_at"
      ]
    }
  }
}
