# ==============================================================================
# SmartProcure-Pay - Environment Variables Template
# Phase 0: Placeholder configuration template
# NOTE: DO NOT commit actual secrets, keys, or passwords to version control.
# Copy this file to .env before local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=4000
ENABLE_SWAGGER=true
CORS_ORIGIN=http://localhost:3000
VITE_API_BASE_URL=/api

# PostgreSQL Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Identity & Access Management (Keycloak - Development Defaults)
KEYCLOAK_PORT=8080
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=smartprocure
KEYCLOAK_CLIENT_ID=smartprocure-web
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin_dev_password
KEYCLOAK_ISSUER=http://localhost:8080/realms/smartprocure
KEYCLOAK_JWKS_URI=http://localhost:8080/realms/smartprocure/protocol/openid-connect/certs
KEYCLOAK_AUDIENCE=smartprocure-api

# API Gateway (Apache APISIX - Issue #4 Integrated)
APISIX_PORT=9080
APISIX_METRICS_PORT=9091
APISIX_URL=http://localhost:9080
APISIX_OIDC_CLIENT_ID=smartprocure-gateway
# DEV ONLY - Override and rotate for production environments:
APISIX_OIDC_CLIENT_SECRET=gateway_dev_secret_123
ENABLE_CORS=false

# Object Storage (MinIO, Issue #7)
MINIO_ENDPOINT=localhost
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
# DEV ONLY - override both secrets in production; never expose MinIO publicly.
MINIO_ACCESS_KEY=minio_dev_only
MINIO_SECRET_KEY=minio_dev_password_only
MINIO_BUCKET_INVOICES=invoices
MINIO_USE_SSL=false
INVOICE_XML_MAX_BYTES=5242880
INVOICE_PDF_MAX_BYTES=20971520

# Business Process Management (Flowable 8.0.0, Issue #9)
# API uses the internal Docker URL. Host scripts use localhost:8088.
FLOWABLE_URL=http://smartprocure-flowable:8080/flowable-rest/service
FLOWABLE_PORT=8088
FLOWABLE_USERNAME=workflow-service
# DEV/CI ONLY; override with managed secrets for production.
FLOWABLE_PASSWORD=flowable_dev_only_password
FLOWABLE_DB_PASSWORD=flowable_db_dev_only_password
FLOWABLE_PROCESS_KEY=invoiceExceptionWorkflow
FLOWABLE_TIMEOUT_MS=10000

# Immutable Ledger Database (ImmuDB)
IMMUDB_HOST=
IMMUDB_PORT=
IMMUDB_DATABASE=
IMMUDB_USER=
IMMUDB_PASSWORD=

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=
GRAFANA_PORT=
