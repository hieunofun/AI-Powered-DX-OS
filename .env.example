# ==============================================================================
# SmartProcure-Pay - Environment Variables Template
# Phase 0: Placeholder configuration template
# NOTE: DO NOT commit actual secrets, keys, or passwords to version control.
# Copy this file to .env before local development.
# ==============================================================================

# Application Environment
NODE_ENV=development
APP_PORT=3000
API_PORT=4000

# PostgreSQL Database
POSTGRES_HOST=
POSTGRES_PORT=
POSTGRES_DB=
POSTGRES_USER=
POSTGRES_PASSWORD=

# Identity & Access Management (Keycloak)
KEYCLOAK_URL=
KEYCLOAK_REALM=
KEYCLOAK_CLIENT_ID=
KEYCLOAK_CLIENT_SECRET=

# API Gateway (Apache APISIX)
APISIX_URL=
APISIX_ADMIN_KEY=

# Object Storage (MinIO)
MINIO_ENDPOINT=
MINIO_PORT=
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET_INVOICES=

# Business Process Management (Flowable)
FLOWABLE_URL=
FLOWABLE_USER=
FLOWABLE_PASSWORD=

# Immutable Ledger Database (ImmuDB)
IMMUDB_HOST=
IMMUDB_PORT=
IMMUDB_DATABASE=
IMMUDB_USER=
IMMUDB_PASSWORD=

# Observability (Prometheus & Grafana)
PROMETHEUS_PORT=
GRAFANA_PORT=
