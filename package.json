{
  "name": "smartprocure-pay-monorepo",
  "version": "0.1.0",
  "private": true,
  "description": "Open-Source Smart Procure-to-Pay & 3-Way e-Invoice Reconciliation Platform",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev:web": "npm run dev --workspace=apps/web",
    "dev:api": "npm run start:dev --workspace=apps/api",
    "build:web": "npm run build --workspace=apps/web",
    "build:api": "npm run build --workspace=apps/api",
    "build": "npm run build:api && npm run build:web",
    "test:web": "npm run test --workspace=apps/web --if-present",
    "test:api": "npm run test --workspace=apps/api",
    "test": "npm run test:api && npm run test:web",
    "lint:web": "npm run lint --workspace=apps/web",
    "lint:api": "npm run lint --workspace=apps/api",
    "lint": "npm run lint:api && npm run lint:web"
  },
  "devDependencies": {
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "eslint": "^8.57.1",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^4.6.2",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.4.5"
  },
  "optionalDependencies": {
    "@rollup/rollup-linux-x64-gnu": "4.63.6",
    "@rollup/rollup-linux-x64-musl": "4.63.6"
  },
  "engines": {
    "node": ">=20.0.0",
    "npm": ">=10.0.0"
  },
  "keywords": [
    "procure-to-pay",
    "3-way-matching",
    "open-source",
    "dx-os",
    "olp-2026"
  ],
  "author": "SmartProcure-Pay Contributors",
  "license": "MIT"
}
